#!/usr/bin/env bash
# =============================================================================
# BOBO OS — runit Stage 1
# /etc/runit/1
#
# Stage 1 runs once at boot before any services start.
# Tasks: mount filesystems, set hostname, setup zram, load kernel modules.
# Must complete quickly — blocks Stage 2 (services).
# =============================================================================

# Redirect all output to /dev/console for visibility during boot
exec >/dev/console 2>&1

echo "==> BOBO OS Stage 1: initialising system..."

# ---------------------------------------------------------------------------
# Mount essential virtual filesystems
# ---------------------------------------------------------------------------
echo "  [mnt] Mounting virtual filesystems..."
mount -t proc  proc       /proc
mount -t sysfs sysfs      /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts    /dev/pts
mount -t tmpfs  tmpfs     /dev/shm
mount -t tmpfs  tmpfs     /run
mount -t tmpfs  tmpfs     /tmp -o mode=1777,nosuid,nodev
mount -t cgroup2 cgroup2  /sys/fs/cgroup 2>/dev/null || true

# ---------------------------------------------------------------------------
# Set hostname from config
# ---------------------------------------------------------------------------
echo "bobo-os" > /proc/sys/kernel/hostname
echo "  [host] Hostname set to: bobo-os"

# ---------------------------------------------------------------------------
# Populate /dev with firmware events (if not already done by devtmpfs)
# ---------------------------------------------------------------------------
if command -v udevd &>/dev/null; then
  udevd --daemon --resolve-names=never
  udevadm trigger --action=add --type=subsystems
  udevadm trigger --action=add --type=devices
  udevadm settle --timeout=10 || true
else
  mdev -s 2>/dev/null || true
fi
echo "  [udev] Device nodes populated."

# ---------------------------------------------------------------------------
# Set up zram compressed swap — must happen before any services use RAM
# Source the zram setup script directly in Stage 1
# ---------------------------------------------------------------------------
echo "  [zram] Setting up compressed RAM..."
if [[ -x /usr/local/lib/bobo/zram-setup.sh ]]; then
  /usr/local/lib/bobo/zram-setup.sh
else
  # Inline fallback — basic zram setup without the full script
  modprobe zram num_devices=1 2>/dev/null || true
  TOTAL_RAM_KB=$(grep MemTotal /proc/meminfo | awk '{print $2}')
  ZRAM_SIZE_KB=$(( TOTAL_RAM_KB / 2 ))
  echo lz4 > /sys/block/zram0/comp_algorithm 2>/dev/null || true
  echo "${ZRAM_SIZE_KB}K" > /sys/block/zram0/disksize 2>/dev/null || true
  mkswap /dev/zram0 2>/dev/null && swapon -p 100 /dev/zram0 2>/dev/null || true
fi
echo "  [zram] Compressed swap active."

# ---------------------------------------------------------------------------
# Load essential kernel modules
# ---------------------------------------------------------------------------
echo "  [mod] Loading kernel modules..."
for mod in \
    loop \
    overlay \
    fuse \
    unix \
    ipv6 \
    nf_conntrack \
    br_netfilter \
    tun \
    veth; do
  modprobe "${mod}" 2>/dev/null || true
done
echo "  [mod] Done."

# ---------------------------------------------------------------------------
# Read-write remount of root partition (it may be mounted read-only by initrd)
# ---------------------------------------------------------------------------
mount -o remount,rw / 2>/dev/null || true

# ---------------------------------------------------------------------------
# Restore system clock from hardware clock
# ---------------------------------------------------------------------------
hwclock -s --utc 2>/dev/null || true
echo "  [clk] System clock synchronised with hardware clock."

# ---------------------------------------------------------------------------
# Seed /dev/urandom from saved entropy pool
# ---------------------------------------------------------------------------
if [[ -f /var/lib/bobo/random-seed ]]; then
  cat /var/lib/bobo/random-seed > /dev/urandom
fi

echo "==> Stage 1 complete — handing off to Stage 2."
