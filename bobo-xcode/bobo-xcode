#!/usr/bin/env python3
"""
BoboXcode launcher (installed to /usr/bin/bobo-xcode).
Re-executes inside the isolated venv when present, then runs main.py.
--version is answered here so verification works without GI/Wayland.
"""
import sys
import os

VENV_PY = "/usr/share/bobo-xcode/venv/bin/python3"
MAIN = "/usr/share/bobo-xcode/main.py"

if "--version" in sys.argv:
    print("BoboXcode 1.0.0 (BOBO OS)")
    sys.exit(0)

# Prefer the isolated venv interpreter (does not affect the system Python).
if os.path.exists(VENV_PY) and os.path.realpath(sys.executable) != os.path.realpath(VENV_PY):
    os.execv(VENV_PY, [VENV_PY, MAIN] + sys.argv[1:])

# Fallback: run with the current interpreter (system libs).
target = MAIN if os.path.exists(MAIN) else os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "main.py")
os.execv(sys.executable, [sys.executable, target] + sys.argv[1:])
